{
  "name": "pi-chat-vscode",
  "displayName": "Pi Chat",
  "description": "Work with Pi coding sessions from a VS Code sidebar.",
  "repository": {
    "type": "git",
    "url": "https://github.com/Pratham-26/pi-extension.git"
  },
  "homepage": "https://github.com/Pratham-26/pi-extension#readme",
  "version": "0.1.54",
  "publisher": "local",
  "engines": {
    "vscode": "^1.109.0"
  },
  "categories": [
    "AI",
    "Chat"
  ],
  "keywords": [
    "pi",
    "coding-agent",
    "chat",
    "workspace-context"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onView:piChat.chatView"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "piChat",
          "title": "Pi Chat",
          "icon": "media/pi.svg"
        }
      ]
    },
    "views": {
      "piChat": [
        {
          "type": "webview",
          "id": "piChat.chatView",
          "name": "Pi Chat"
        }
      ]
    },
    "commands": [
      {
        "command": "piChat.newSession",
        "title": "New Pi Chat",
        "category": "Pi Chat",
        "icon": "$(add)"
      },
      {
        "command": "piChat.cloneSession",
        "title": "Clone Active Pi Chat",
        "category": "Pi Chat",
        "icon": "$(copy)"
      },
      {
        "command": "piChat.createWorktree",
        "title": "Pi Chat: Create Git Worktree",
        "category": "Pi Chat",
        "icon": "$(git-branch)"
      },
      {
        "command": "piChat.removeWorktree",
        "title": "Pi Chat: Remove Git Worktree",
        "category": "Pi Chat"
      },
      {
        "command": "piChat.openSettings",
        "title": "Pi Chat: Open Settings",
        "category": "Pi Chat"
      },
      {
        "command": "piChat.chooseAgentDir",
        "title": "Pi Chat: Choose Pi Configuration Folder",
        "category": "Pi Chat"
      },
      {
        "command": "piChat.manageRuntimeEnvironment",
        "title": "Pi Chat: Manage Pi Runtime Environment Variables",
        "category": "Pi Chat"
      },
      {
        "command": "piChat.manageMcpServers",
        "title": "Pi Chat: Manage MCP Servers",
        "category": "Pi Chat"
      },
      {
        "command": "piChat.restartRuntime",
        "title": "Pi Chat: Restart Pi Runtime",
        "category": "Pi Chat"
      },
      {
        "command": "piChat.exportDiagnostics",
        "title": "Pi Chat: Export Redacted Diagnostic Report",
        "category": "Pi Chat"
      },
      {
        "command": "piChat.openLogs",
        "title": "Pi Chat: Open Local Diagnostic Log",
        "category": "Pi Chat"
      }
    ],
    "configuration": {
      "title": "Pi Chat",
      "properties": {
        "piChat.agentDir": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Use this Pi configuration folder for models, credentials, resources, and sessions. Empty uses Pi's default or PI_CODING_AGENT_DIR. Restart the Pi runtime after editing this setting."
        },
        "piChat.offlineMode": {
          "type": "string",
          "enum": [
            "inherit",
            "offline",
            "online"
          ],
          "enumDescriptions": [
            "Keep the PI_OFFLINE environment setting inherited by the Pi worker.",
            "Set PI_OFFLINE=1 to disable automatic Pi startup network operations.",
            "Remove PI_OFFLINE from the Pi worker environment and allow startup network operations."
          ],
          "default": "inherit",
          "scope": "machine",
          "description": "Choose Pi's startup network behavior. Offline mode does not block model API requests. Restart the Pi runtime after changing this setting."
        },
        "piChat.context.followSelection": {
          "type": "boolean",
          "default": true,
          "description": "Include the active editor selection as a file and line reference when you send a message."
        },
        "piChat.context.followActiveFile": {
          "type": "boolean",
          "default": false,
          "description": "Include the active editor file as a reference with each message when there is no selection."
        },
        "piChat.context.includeDiagnostics": {
          "type": "boolean",
          "default": false,
          "description": "Include diagnostics from the active workspace file with each message."
        },
        "piChat.context.includeGitStatus": {
          "type": "boolean",
          "default": false,
          "description": "Include the active workspace Git branch and changed file names with each message."
        },
        "piChat.sessions.autoName": {
          "type": "boolean",
          "default": true,
          "description": "Name an unnamed Pi session from its first non-command prompt without making an extra provider request."
        },
        "piChat.sessions.openLatestOnStart": {
          "type": "boolean",
          "default": false,
          "description": "Open the most recently updated Pi session for this workspace when the chat view starts. Pi project resources remain subject to the existing trust prompt."
        },
        "piChat.mcp.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Connect enabled servers from Pi MCP configuration after an explicit confirmation."
        },
        "piChat.notifications.runFinished": {
          "type": "boolean",
          "default": true,
          "description": "Show a VS Code notification when a Pi run finishes while the chat view is hidden."
        },
        "piChat.notifications.inputRequired": {
          "type": "boolean",
          "default": true,
          "description": "Show a VS Code notification when a Pi extension asks for input while the chat view is hidden."
        }
      }
    },
    "menus": {
      "view/title": [
        {
          "command": "piChat.newSession",
          "when": "view == piChat.chatView",
          "group": "navigation"
        },
        {
          "command": "piChat.cloneSession",
          "when": "view == piChat.chatView",
          "group": "navigation"
        },
        {
          "command": "piChat.createWorktree",
          "when": "view == piChat.chatView",
          "group": "navigation"
        },
        {
          "command": "piChat.openSettings",
          "when": "view == piChat.chatView",
          "group": "navigation"
        },
        {
          "command": "piChat.exportDiagnostics",
          "when": "view == piChat.chatView",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "compile": "npm run compile:extension && npm run compile:worker && npm run compile:webview",
    "compile:extension": "esbuild src/extension.ts --bundle --platform=node --target=node22 --external:vscode --outfile=dist/extension.js",
    "compile:worker": "esbuild src/pi-worker.ts --bundle --platform=node --target=node22 --format=esm --external:@earendil-works/pi-coding-agent --outfile=dist/pi-worker.mjs",
    "compile:webview": "esbuild src/webview-renderers.js --bundle --platform=browser --target=es2022 --format=iife --minify --legal-comments=linked --outfile=dist/webview-renderers.js",
    "typecheck": "tsc --noEmit",
    "package": "npm run compile && vsce package"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "1.4.0"
  },
  "overrides": {
    "@earendil-works/pi-coding-agent": {
      "undici": "8.12.2"
    },
    "@azure/identity": {
      "@azure/msal-node": "7.1.2"
    }
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@types/vscode": "^1.109.0",
    "@vscode/vsce": "^3.3.2",
    "esbuild": "^0.25.0",
    "katex": "0.19.1",
    "mermaid": "12.2.0",
    "typescript": "^5.8.3"
  }
}
